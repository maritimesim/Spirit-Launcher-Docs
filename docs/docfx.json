{
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "KM_Wordmark_Stacked_Anchor_RGB.png",
          "KM_Wordmark_Stacked_Negative_RGB.png"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/spiritlauncher"
    ],
    "globalMetadata": {
      "_appTitle": "Spirit Launcher Docs",
      "_appName": "Spirit Launcher",
      "_appLogoPath": "KM_Wordmark_Stacked_Anchor_RGB.png",
      "_appFooter": "Spirit Launcher documentation",
      "_disableContribution": true
    }
  }
}